{
  "name": "dsh-computer-use-rawinput",
  "version": "0.8.3-rawinput.1",
  "description": "DeepSeek Harness computer-use plugin (Windows fork of @copylee/dsh-computer-use): moves the pointer with injected absolute movement so games and other Raw Input / DirectInput programs accept the clicks too.",
  "type": "module",
  "author": "HSCisAvailableForUsername and DeepSeek (fork of copylee´s dsh-computer-use)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HSCisAvailableForUsername/dsh-computer-use-rawinput.git"
  },
  "bugs": {
    "url": "https://github.com/HSCisAvailableForUsername/dsh-computer-use-rawinput/issues"
  },
  "homepage": "https://github.com/HSCisAvailableForUsername/dsh-computer-use-rawinput#readme",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native-worker.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "helper/CuHelper.cs",
    "helper/host.ps1",
    "helper/deepseek-white.png",
    "helper/deepseek-black.png",
    "helper/skills/*.md",
    "cordis.patch.yml",
    "README.md",
    "PATCH.md",
    "LICENSE"
  ],
  "os": [
    "win32"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-agent",
    "computer-use",
    "desktop-automation",
    "windows",
    "raw-input",
    "directinput",
    "games",
    "screenshot",
    "ui-automation",
    "cordis"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/schemastery": ">=3.18.0 <4",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
